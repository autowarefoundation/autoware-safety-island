Eigen 3.4 psincos_float: type the integer scratch buffer on the packet's own
scalar (int32_t) instead of plain `int`.

On arm-none-eabi (Cortex-R52, ILP32) newlib types int32_t as `long`, so `int` !=
`int32_t` even though both are 32-bit. Eigen's NEON integer packets (Packet2i/
Packet4i) and their pload/pstore specializations are keyed on int32_t, but
psincos_float declares the huge-argument scratch buffer as plain `int` and then
calls pstoreu/ploadu<PacketI> on it -> no matching specialization -> the generic
fallback `*to = from` fails to compile. Every other vectorised transcendental
(plog/pexp/pldexp/pfrexp) already uses the packet's ScalarI type; psincos is the
only offender. trig_reduce_huge() still takes int*, so the one in-loop use writes
into a plain `int` temporary and then assigns it back into y_int2[k] (a defined
int -> ScalarI conversion), avoiding a strict-aliasing violation from casting a
ScalarI* to int*.

Applied at configure time over the host Eigen tree (see freertos_s32z2/
CMakeLists.txt); not an upstreamed change.

--- a/Eigen/src/Core/arch/Default/GenericPacketMathFunctions.h
+++ b/Eigen/src/Core/arch/Default/GenericPacketMathFunctions.h
@@ -625,6 +625,7 @@
 Packet psincos_float(const Packet& _x)
 {
   typedef typename unpacket_traits<Packet>::integer_packet PacketI;
+  typedef typename unpacket_traits<PacketI>::type ScalarI;  // PATCHED: arm-none-eabi int32_t==long

   const Packet  cst_2oPI            = pset1<Packet>(0.636619746685028076171875f); // 2/PI
   const Packet  cst_rounding_magic  = pset1<Packet>(12582912); // 2^23 for rounding
@@ -685,7 +686,7 @@
     const int PacketSize = unpacket_traits<Packet>::size;
     EIGEN_ALIGN_TO_BOUNDARY(sizeof(Packet)) float vals[PacketSize];
     EIGEN_ALIGN_TO_BOUNDARY(sizeof(Packet)) float x_cpy[PacketSize];
-    EIGEN_ALIGN_TO_BOUNDARY(sizeof(Packet)) int y_int2[PacketSize];
+    EIGEN_ALIGN_TO_BOUNDARY(sizeof(Packet)) ScalarI y_int2[PacketSize];  // PATCHED: was int; packet scalar is int32_t(==long)
     pstoreu(vals, pabs(_x));
     pstoreu(x_cpy, x);
     pstoreu(y_int2, y_int);
@@ -693,7 +694,11 @@
     {
       float val = vals[k];
       if(val>=huge_th && (numext::isfinite)(val))
-        x_cpy[k] = trig_reduce_huge(val,&y_int2[k]);
+      {  // PATCHED: trig_reduce_huge wants int*; use an int temporary instead of
+        int y_tmp;  // aliasing a ScalarI(==long) through int* (strict-aliasing UB)
+        x_cpy[k] = trig_reduce_huge(val, &y_tmp);
+        y_int2[k] = y_tmp;  // defined int -> ScalarI conversion
+      }
     }
     x = ploadu<Packet>(x_cpy);
     y_int = ploadu<PacketI>(y_int2);
